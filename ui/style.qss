/* Global styling for MainWindow, Settings, Search, and Tags views */
QMainWindow, QDialog, QMessageBox, QInputDialog {
    background-color: #0f0f13;
    color: #e4e4e7;
}

QWidget {
    font-family: "Segoe UI", Arial, sans-serif;
}

/* Ensure view widgets have a clean dark background */
QWidget#gallery_view, QWidget#tags_view, QWidget#search_view, QWidget#settings_view {
    background-color: #0f0f13;
}

/* Labels */
QLabel {
    color: #e4e4e7;
}

/* Scroll Areas */
QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* Custom Scrollbars */
QScrollBar:vertical {
    background-color: #121214;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #2c2c3e;
    min-height: 20px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #0078d4;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: #121214;
    height: 10px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #2c2c3e;
    min-width: 20px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #0078d4;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* Tab Widget and Tab Bar */
QTabWidget::pane {
    border: 1px solid #1e1e2d;
    background-color: #0f0f13;
    border-radius: 8px;
    top: -1px;
}

QTabBar::tab {
    background-color: #161622;
    color: #a1a1aa;
    padding: 10px 20px;
    border: 1px solid #1e1e2d;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    font-size: 13px;
    font-weight: 600;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #0f0f13;
    color: #ffffff;
    border-bottom: 2px solid #0078d4;
}

QTabBar::tab:hover:!selected {
    background-color: #1e1e2d;
    color: #e4e4e7;
}

/* Group Boxes in Settings */
QGroupBox {
    border: 1px solid #1e1e2d;
    border-radius: 8px;
    margin-top: 1.5em;
    font-weight: bold;
    color: #ffffff;
    font-size: 14px;
    padding: 15px;
    background-color: #161622;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    left: 10px;
}

/* General Buttons */
QPushButton {
    background-color: #161622;
    border: 1px solid #2c2c3e;
    color: #e4e4e7;
    padding: 8px 16px;
    border-radius: 8px;
    font-weight: 500;
    font-size: 12px;
}

QPushButton:hover {
    background-color: #002d54;
    border-color: #0078d4;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #005a9e;
    border-color: #0078d4;
    color: #ffffff;
}

QPushButton:disabled {
    background-color: #1c1917;
    border-color: #2e2a24;
    color: #78716c;
}

/* Input Fields and Dropdowns */
QLineEdit, QDateEdit, QComboBox {
    background-color: #161622;
    border: 1px solid #2c2c3e;
    border-radius: 6px;
    color: #ffffff;
    padding: 6px 12px;
}

QLineEdit:focus, QDateEdit:focus, QComboBox:focus {
    border-color: #0078d4;
}

QComboBox::drop-down, QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left-width: 1px;
    border-left-color: #2c2c3e;
    border-left-style: solid;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

QComboBox::down-arrow, QDateEdit::down-arrow {
    image: url(assets/icons/chevron-down.svg);
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background-color: #161622;
    border: 1px solid #2c2c3e;
    selection-background-color: #0078d4;
    selection-color: #ffffff;
    color: #ffffff;
}

/* List Widgets (like directory list in settings) */
QListWidget {
    background-color: #161622;
    border: 1px solid #1e1e2d;
    border-radius: 6px;
    color: #e4e4e7;
    padding: 5px;
}

QListWidget::item {
    padding: 8px;
    border-radius: 4px;
}

QListWidget::item:selected {
    background-color: #0078d4;
    color: #ffffff;
}

QListWidget::item:hover:!selected {
    background-color: #27273a;
    color: #f3f4f6;
}

QDialog QListWidget::item:selected {
    background-color: transparent;
    color: #ffffff;
}

QDialog QListWidget::item:hover {
    background-color: #27273a;
    color: #ffffff;
}

/* Context Menus */
QMenu {
    background-color: #161622;
    border: 1px solid #2c2c3e;
    border-radius: 6px;
    color: #e4e4e7;
    padding: 4px 0px;
}

QMenu::item {
    padding: 6px 20px;
    border-radius: 4px;
    margin: 2px 4px;
}

QMenu::item:selected {
    background-color: #0078d4;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #2c2c3e;
    margin: 4px 0px;
}

/* Custom Checkboxes in List Widgets & Dialogs */
QCheckBox {
    color: #e4e4e7;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
}

QCheckBox::indicator:unchecked {
    image: url(assets/icons/unchecked-box.svg);
}

QCheckBox::indicator:checked {
    image: url(assets/icons/checked-box.svg);
}

/* Calendar Widget overrides */
QCalendarWidget QWidget {
    alternate-background-color: #161622;
    background-color: #0f0f13;
    color: #e4e4e7;
}

QCalendarWidget QAbstractItemView:enabled {
    color: #ffffff;
    background-color: #161622;
    selection-background-color: #0078d4;
    selection-color: #ffffff;
}

QCalendarWidget QAbstractItemView:disabled {
    color: #4b5563;
}

QCalendarWidget QMenu {
    background-color: #161622;
    color: #ffffff;
}
